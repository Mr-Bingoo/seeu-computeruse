{
  "manifest_version": 3,
  "name": "SeeU 浏览器助手",
  "version": "0.1.0",
  "description": "让本机的 SeeU 在你允许的网站上后台读网页、点按钮、填表。只跟本机程序通信,不联网上传。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SeeU",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "minimum_chrome_version": "116"
}